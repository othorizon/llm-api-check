{
  // Cloudflare Workers 静态资源部署：npm run deploy
  // Cloudflare Pages 用户改用：npm run deploy:pages
  "name": "which-llm-i-can-use",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // 目录形式的 /docs → /docs/index.html
    "html_handling": "auto-trailing-slash",
    // 所有路由在构建时都已生成静态 HTML，未命中的路径返回真正的 404 而不是首页
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  }
}
